# To-Do List with File Storage
import json

FILE = "todo.json"

def load_tasks():
    try:
        with open(FILE, "r") as f:
            return json.load(f)
    except:
        return []

def save_tasks(tasks):
    with open(FILE, "w") as f:
        json.dump(tasks, f)

def todo_app():
    tasks = load_tasks()
    while True:
        print("\n1.Add 2.View 3.Delete 4.Exit")
        ch = input("Choice: ")
        if ch == "1":
            t = input("Task: ")
            tasks.append(t)
            save_tasks(tasks)
        elif ch == "2":
            for i, t in enumerate(tasks, 1):
                print(i, t)
        elif ch == "3":
            idx = int(input("Delete index: ")) - 1
            if 0 <= idx < len(tasks):
                tasks.pop(idx)
                save_tasks(tasks)
        else:
            break
