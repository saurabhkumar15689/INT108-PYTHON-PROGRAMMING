# Student Grade System

class Student:
    def __init__(self, name, marks):
        self.name = name
        self.marks = marks
    
    def grade(self):
        avg = sum(self.marks)/len(self.marks)
        if avg >= 90:
            return "A"
        elif avg >= 75:
            return "B"
        else:
            return "C"

s = Student("John", [85, 90, 78])
print("Grade:", s.grade())
