#Day 1 – Number Guessing Game

import random

def guess_game():
    number = random.randint(1, 100)
    attempts = 0
    
    while True:
        guess = int(input("Guess a number (1-100): "))
        attempts += 1
        
        if guess < number:
            print("Too low")
        elif guess > number:
            print("Too high")
        else:
            print(f"Correct! Attempts: {attempts}")
            break

guess_game()
